# 必須。deploy-backend.sh は初回配置時に64桁のランダム値を生成する。
# 手動配置時も32文字以上512文字以下のランダム値にすること。
# change-me 等の既知プレースホルダーは起動時に拒否される。
VSPO_API_KEY=

# 末尾の http://localhost / https://localhost / capacitor://localhost は Android (Capacitor) の WebView オリジン
VSPO_ALLOWED_ORIGINS=http://localhost,https://localhost,capacitor://localhost

# デスクトップアプリは UI をループバックの「ランダムポート」から配信するため、
# 上の固定リストでは Origin が一致しない。ループバック全ポートを許可する。
# API キーが必須なので、これだけで無認証アクセスが通ることはない。
VSPO_ALLOWED_ORIGIN_REGEX='^http://(127\.0\.0\.1|localhost)(:\d+)?$'

# RSSによる公式チャンネルの新着検知間隔（秒）
VSPO_DISCOVERY_SECONDS=60

# 動画・配信タブ、切り抜き検索、詳細を含む完全更新の間隔（秒）
VSPO_REFRESH_SECONDS=600

# 最後に成功したフィードを再起動後も即時配信するための永続キャッシュ。
# systemd unit の CacheDirectory 配下を使う。
VSPO_FEED_CACHE_PATH=/var/cache/vspo-backend/feed.json

# 配信状態を個別確認する各チャンネルの直近件数と並列数。
# YouTubeの429とDenoプロセスのメモリ使用量を抑える本番既定値。
# extract_flat の一覧に live_status が含まれるため通常は追加取得しない。
# YouTube の仕様変更時だけ 1-20 に上げて個別確認を有効化する。
VSPO_STREAM_DETAIL_LIMIT_PER_CHANNEL=0
VSPO_STREAM_DETAIL_WORKERS=4

# 1 クライアントあたりの毎分リクエスト上限（コメント取得など重いエンドポイントに適用）
VSPO_RATE_LIMIT_PER_MIN=20

# レート制限で保持するクライアント識別子の最大数
VSPO_RATE_LIMIT_MAX_CLIENTS=4096

# WebSocket 接続試行の1クライアントあたり毎分上限
VSPO_WS_CONNECTIONS_PER_MIN=30

# 同時に開くライブチャットのルーム数（＝pytchat セッション数）の上限。
# 毎分の接続試行だけを絞っても、別々の動画IDで張り続けられれば
# ルームは際限なく増え、スレッドが尽きて全ルームのチャットが止まる。
VSPO_WS_MAX_ROOMS=64

# 1 クライアント（レート制限キー単位）が同時に開けるルーム数。
# これが無いと 1 人が別々の動画IDで全枠(VSPO_WS_MAX_ROOMS)を占有し、
# 他の視聴者のライブチャットを止められる。
VSPO_WS_MAX_ROOMS_PER_CLIENT=5

# Cloudflare Tunnel が付与する CF-Connecting-IP をクライアント識別に使う。
# Tunnelを経由しない構成では0にすること。
VSPO_TRUST_CLOUDFLARE_HEADERS=1

# CF-Connecting-IP を信頼するのは、直接の TCP ピアがこのネットワークに
# 属するときだけ。cloudflared は同一ホストのループバックから 8010 へ繋ぐので
# 既定はループバックのみ。これを検証しないと、nginx:80 等バックエンドへ
# 直接届く別経路から CF-Connecting-IP を偽装してレート制限を無効化できる。
# カンマ区切りの CIDR。通常は既定のままでよい。
VSPO_TRUSTED_PROXY_NETWORKS=127.0.0.0/8,::1/128

# コメント取得結果のキャッシュ保持時間（秒）
VSPO_COMMENTS_CACHE_TTL=300

# 同時に走らせる yt-dlp 抽出の上限
VSPO_MAX_EXTRACTIONS=4

# YouTube外部I/Oのタイムアウトと再試行
VSPO_UPSTREAM_TIMEOUT_SECONDS=20
VSPO_UPSTREAM_RETRIES=2

# API キー無しで 0.0.0.0 に公開することを明示的に許可する場合のみ 1。
# 通常は設定しないこと。
# VSPO_ALLOW_INSECURE_BIND=0
